    "Identity File (optional)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身份文件（可选）"
          }
        }
      }
    },
    "If you enabled the system-level SOCKS proxy while the tunnel was up, this restores direct internet access." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你在隧道连接期间启用了系统级 SOCKS 代理，此命令可恢复直接上网。"
          }
        }
      }
    },
