    "Add Tunnel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加隧道"
          }
        }
      }
    },
    "Adds -J <value>. Reaches the host through one or more bastion hosts, replacing a manual multi-hop ssh." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 -J <值>。通过一个或多个堡垒机连接到主机，替代手动多跳 ssh。"
          }
        }
      }
    },
    "Adds -o PermitLocalCommand=yes -o LocalCommand=<value>. ssh waits for the command to finish before serving the tunnel, so end long-running commands with &." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 -o PermitLocalCommand=yes -o LocalCommand=<值>。ssh 会等命令执行完毕后才开始提供隧道，因此长时间运行的命令请以 & 结尾。"
          }
        }
      }
    },
    "Advanced" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级"
