      "shouldTranslate" : false
    },
    "A blank field uses its placeholder default; hover a field for what it does. Connect Timeout is off unless set." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空的字段将使用占位符中的默认值；将鼠标悬停在字段上可查看其作用。连接超时未设置时不启用。"
          }
        }
      }
    },
    "A local forward port is already in use." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个本地转发端口已被占用。"
          }
        }
      }
    },
    "Add a group divider" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
