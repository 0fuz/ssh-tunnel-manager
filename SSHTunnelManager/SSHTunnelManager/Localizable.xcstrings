          "stringUnit" : {
            "state" : "translated",
            "value" : "主机"
          }
        }
      }
    },
    "Host key changed — enable “Skip host key check” if the host was recreated." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机密钥已变更。如果主机是重建的，请启用“跳过主机密钥检查”。"
          }
        }
      }
    },
    "Host unreachable — check the network or a firewall." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
